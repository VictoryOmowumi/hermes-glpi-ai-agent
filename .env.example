# Copy to ".env" and fill in. Never commit the real .env.

# GLPI REST API
GLPI_BASE_URL=http://localhost:8888/glpi/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
# Optional separate account used only for approved category changes
GLPI_CATEGORY_USER_TOKEN=

# AI providers
GROQ_API_KEY=
GEMINI_API_KEY=
# Keep false unless a paid, approved Gemini/Vertex AI setup is in place (free tier may train on content)
GEMINI_FALLBACK_ENABLED=false

# Hermes behaviour
HERMES_DEFAULT_GROUP_ID=1
HERMES_SELF_SERVICE_SOURCE_ID=0
HERMES_HANDLE_TICKETS_FROM=2026-10-15 00:00:00
HERMES_AUTOMATED_SENDERS=
# Shared service key for callers of the Hermes API (for example the intranet back end)
HERMES_API_KEY=

# Safety controls
HERMES_READ_ONLY=false
HERMES_MAX_WRITES_PER_HOUR=400
HERMES_MAX_WRITES_PER_TICKET=30
HERMES_ALLOWED_LINK_DOMAINS=
HERMES_ALLOWED_CONTACTS=

# Storage
PORTAL_DB_PATH=
HERMES_CHAT_RETENTION_DAYS=365
PORTAL_ADMIN_EMAILS=
