# Copy this file to ".streamlit/secrets.toml" and fill in the values from Google Cloud Console
# to switch the portal from demo sign-in to real single sign-on with Google Workspace accounts.
# Keep secrets.toml out of version control.
#
# Where the values come from (Google Cloud Console, in a project owned by your Workspace organization):
#   1. APIs & Services > OAuth consent screen: set User type to "Internal" so only your
#      organization's accounts can sign in.
#   2. APIs & Services > Credentials > Create credentials > OAuth client ID > Web application.
#      Add the redirect_uri below under "Authorized redirect URIs".
#   3. Copy the generated client ID and client secret into this file.

[auth]
# Must match the redirect address registered on the OAuth client
redirect_uri = "http://localhost:8501/oauth2callback"
# Any long random string; generate one with: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"
client_id = "REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com"
client_secret = "REPLACE_WITH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
